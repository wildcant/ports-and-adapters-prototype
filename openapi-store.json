{
  "openapi": "3.1.0",
  "info": {
    "title": "Store API",
    "version": "0.1.0"
  },
  "servers": [
    {
      "url": "http://localhost:3000"
    }
  ],
  "components": {
    "schemas": {},
    "parameters": {}
  },
  "paths": {
    "/store/carts": {
      "post": {
        "operationId": "createStoreCart",
        "summary": "Create a cart",
        "tags": ["Carts"],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "currencyCode": {
                    "type": "string",
                    "minLength": 1
                  },
                  "email": {
                    "type": "string",
                    "format": "email"
                  },
                  "items": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "title": {
                          "type": "string",
                          "minLength": 1
                        },
                        "quantity": {
                          "type": "integer",
                          "exclusiveMinimum": 0
                        },
                        "unitPrice": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "variantId": {
                          "type": "string"
                        },
                        "productId": {
                          "type": "string"
                        },
                        "productTitle": {
                          "type": "string"
                        },
                        "variantSku": {
                          "type": "string"
                        }
                      },
                      "required": ["title", "quantity", "unitPrice"]
                    }
                  }
                },
                "required": ["currencyCode"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response"
          },
          "400": {
            "description": "Validation error"
          }
        }
      }
    },
    "/store/carts/{id}": {
      "get": {
        "operationId": "getStoreCart",
        "summary": "Retrieve a cart with line items",
        "tags": ["Carts"],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "minLength": 1
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response"
          },
          "400": {
            "description": "Validation error"
          },
          "404": {
            "description": "Not found"
          }
        }
      },
      "post": {
        "operationId": "updateStoreCart",
        "summary": "Update a cart",
        "tags": ["Carts"],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "minLength": 1
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email"
                  },
                  "currencyCode": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response"
          },
          "400": {
            "description": "Validation error"
          },
          "404": {
            "description": "Not found"
          }
        }
      }
    },
    "/store/carts/{id}/line-items": {
      "post": {
        "operationId": "addStoreCartLineItem",
        "summary": "Add a line item to a cart",
        "tags": ["Carts"],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "minLength": 1
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "title": {
                    "type": "string",
                    "minLength": 1
                  },
                  "quantity": {
                    "type": "integer",
                    "exclusiveMinimum": 0
                  },
                  "unitPrice": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "variantId": {
                    "type": "string"
                  },
                  "productId": {
                    "type": "string"
                  },
                  "productTitle": {
                    "type": "string"
                  },
                  "variantSku": {
                    "type": "string"
                  }
                },
                "required": ["title", "quantity", "unitPrice"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response"
          },
          "400": {
            "description": "Validation error"
          },
          "404": {
            "description": "Not found"
          }
        }
      }
    },
    "/store/carts/{id}/line-items/{lineId}": {
      "post": {
        "operationId": "updateStoreCartLineItem",
        "summary": "Update a cart line item",
        "tags": ["Carts"],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "minLength": 1
            },
            "required": true,
            "name": "id",
            "in": "path"
          },
          {
            "schema": {
              "type": "string",
              "minLength": 1
            },
            "required": true,
            "name": "lineId",
            "in": "path"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "quantity": {
                    "type": "integer",
                    "exclusiveMinimum": 0
                  },
                  "unitPrice": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response"
          },
          "400": {
            "description": "Validation error"
          },
          "404": {
            "description": "Not found"
          }
        }
      },
      "delete": {
        "operationId": "deleteStoreCartLineItem",
        "summary": "Remove a line item from a cart",
        "tags": ["Carts"],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "minLength": 1
            },
            "required": true,
            "name": "id",
            "in": "path"
          },
          {
            "schema": {
              "type": "string",
              "minLength": 1
            },
            "required": true,
            "name": "lineId",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response"
          },
          "400": {
            "description": "Validation error"
          },
          "404": {
            "description": "Not found"
          }
        }
      }
    },
    "/store/carts/{id}/complete": {
      "post": {
        "operationId": "completeStoreCart",
        "summary": "Complete a cart (authorize payment and mark as completed)",
        "tags": ["Carts"],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "minLength": 1
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response"
          },
          "400": {
            "description": "Validation error"
          },
          "404": {
            "description": "Not found"
          }
        }
      }
    },
    "/store/payment-collections": {
      "post": {
        "operationId": "createStorePaymentCollection",
        "summary": "Create a payment collection for a cart",
        "tags": ["Payment Collections"],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "cartId": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": ["cartId"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response"
          },
          "400": {
            "description": "Validation error"
          }
        }
      }
    },
    "/store/payment-collections/{id}/payment-sessions": {
      "post": {
        "operationId": "createStorePaymentSession",
        "summary": "Create a payment session",
        "tags": ["Payment Collections"],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "minLength": 1
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "providerId": {
                    "type": "string",
                    "minLength": 1
                  },
                  "data": {
                    "type": "object",
                    "additionalProperties": {}
                  },
                  "context": {
                    "type": "object",
                    "additionalProperties": {}
                  }
                },
                "required": ["providerId"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response"
          },
          "400": {
            "description": "Validation error"
          },
          "404": {
            "description": "Not found"
          }
        }
      }
    },
    "/store/payment-providers": {
      "get": {
        "operationId": "listStorePaymentProviders",
        "summary": "List enabled payment providers",
        "tags": ["Payments"],
        "responses": {
          "200": {
            "description": "Successful response"
          },
          "400": {
            "description": "Validation error"
          }
        }
      }
    },
    "/store/products": {
      "get": {
        "operationId": "listStoreProducts",
        "summary": "List published products",
        "tags": ["Products"],
        "responses": {
          "200": {
            "description": "Successful response"
          },
          "400": {
            "description": "Validation error"
          }
        }
      }
    },
    "/store/products/{id}": {
      "get": {
        "operationId": "getStoreProduct",
        "summary": "Retrieve a product with variants",
        "tags": ["Products"],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "minLength": 1
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response"
          },
          "400": {
            "description": "Validation error"
          },
          "404": {
            "description": "Not found"
          }
        }
      }
    }
  },
  "webhooks": {}
}
